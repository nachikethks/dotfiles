# Modular zsh secrets file - never commit
zsh/.config/zsh/conf.d/99-secrets.zsh
fish/.config/fish/conf.d/99-secrets.fish

# Auto-managed by fish (universal vars) - machine-specific
fish/.config/fish/fish_variables

# Auto-generated completions (e.g. docker completion fish)
fish/.config/fish/completions/

# Fisher-managed files (installed/updated by fisher)
fish/.config/fish/functions/fisher.fish
fish/.config/fish/functions/fzf_configure_bindings.fish
fish/.config/fish/functions/_fzf_*
fish/.config/fish/functions/_autopair_*
fish/.config/fish/conf.d/fzf.fish
fish/.config/fish/conf.d/done.fish
fish/.config/fish/conf.d/autopair.fish

git/.config/git/local.conf

# Build artifacts and logs
nvim/.config/nvim/startup.log
nvim/.config/nvim/lazygit/
nvim/.config/nvim/lazy-lock.json

btop/.config/btop/btop.log
btop/.config/btop/btop.conf

tmux/.config/tmux/plugins/

.claude/

# Completion cache
zsh/.config/zsh/.zcompdump*

CLAUDE.md
